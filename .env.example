# Copy to .env. load_dotenv() reads it from the working directory.
# Only ANTHROPIC_API_KEY is required for the default provider.
# Leave a line commented to keep the code default.

# --- Model provider ----------------------------------------------------------
# anthropic | openai | openrouter | gemini
# PAPERCLIP_PROVIDER=anthropic

# Used when PAPERCLIP_API_KEY is empty. Set the one that matches the provider.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Optional override of the provider key above.
# PAPERCLIP_API_KEY=

# Empty model fields fall back to the provider default:
#   anthropic   claude-sonnet-5 / claude-haiku-4-5-20251001
#   openai      gpt-5.5 / gpt-4.1-mini
#   openrouter  nvidia/nemotron-nano-9b-v2:free / google/gemma-3-4b-it:free
#   gemini      gemini-3.8-flash / gemini-3.5-flash-lite
# PAPERCLIP_MODEL=
# PAPERCLIP_SMALL_MODEL=
# PAPERCLIP_BASE_URL=
# PAPERCLIP_LLM_TIMEOUT=120
# PAPERCLIP_MAX_TOKENS=2048
# PAPERCLIP_MAX_ITERATIONS=10

# Judge evals and the release gate look at ANTHROPIC_API_KEY only.

# --- Home and memory ---------------------------------------------------------
# PAPERCLIP_HOME=.paperclip
# PAPERCLIP_SEMANTIC_STORE=sqlite
# PAPERCLIP_RETRIEVAL_TOP_K=4
# PAPERCLIP_CONSOLIDATE_EVERY=6

# Only when PAPERCLIP_SEMANTIC_STORE=supabase. Embeddings use OPENAI_API_KEY.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Search ------------------------------------------------------------------
# Tavily when set; otherwise DuckDuckGo. PAPERCLIP_SEARCH_API_KEY is an alias.
# TAVILY_API_KEY=
# PAPERCLIP_SEARCH_API_KEY=

# --- Telegram ----------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# Numeric user id. Unset means anyone who finds the bot can use it.
# TELEGRAM_ALLOWED_USER=

# --- macOS -------------------------------------------------------------------
# 1, true, or yes. Calendar.app sync is separate from the AppleScript tools.
# PAPERCLIP_APPLE_CALENDAR=
# PAPERCLIP_APPLE_TOOLS=
# PAPERCLIP_APPLE_CALENDARS=Work,Home

# --- Voice -------------------------------------------------------------------
# PAPERCLIP_WHISPER_MODEL=base
# cpu avoids a missing cublas64_12.dll on machines without the CUDA 12 runtime.
# PAPERCLIP_WHISPER_DEVICE=cpu
# PAPERCLIP_WHISPER_LANG=
# Default wake phrases: paperclip paperclip,paperclippaperclip,paperclip,paper clip,paper-clip
# Set empty for push-to-talk.
# PAPERCLIP_WAKE_WORD=
# PAPERCLIP_WAKE_LANG=
# PAPERCLIP_WAKE_ACK=Yes?
# PAPERCLIP_FOLLOWUP_SECONDS=8
# PAPERCLIP_MIC_THRESHOLD=0.005
# PAPERCLIP_TTS=
# PAPERCLIP_VOICE=

# --- Dashboard and traces ----------------------------------------------------
# PAPERCLIP_DASHBOARD_PORT=7777
# PORT=7777
# PAPERCLIP_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PAPERCLIP_EDITOR=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Tools -------------------------------------------------------------------
# PAPERCLIP_EXPERIMENTAL=
# Default owner/name when github_read is called without a repo. Auth stays in gh.
# PAPERCLIP_GITHUB_REPO=
